/**
 * System Views
 * 
 * Defines visualizations of the system architecture.
 * All views must be nested inside category folders (C1, C2, C3, Use Cases, Deployment, Operations).
 */
views {
 view index extends c1_context {}
}
views 'C1' {
  /**
   * C1: System Context
   * Shows the system in its environment with users and external dependencies
   */
  view c1_context {
    title 'System Context'
    
    include user
    include mySystem with {
      // Drill down to containers from the system context
      navigateTo c2_containers
    }
    include emailService
    
    // Layout hints: actors at the top, external systems at the bottom
    rank source { user }
    rank sink { emailService }
  }
  
}

views 'C2' {
  /**
   * C2: Container View
   * Shows the internal structure of the system with its containers
   */
  view c2_containers {
    title 'Containers'
    
    include user
    include mySystem.*        // All containers within mySystem
    include mySystem.webapp with {
      // Example: click the Web Application to drill down
      navigateTo c2_webapp_details
    }
    include emailService
    
    // Layout hints
    rank source { user }
    rank sink { mySystem.database, emailService }
  }
  
  /**
   * C2: Container View (Focused)
   * Alternative view showing only core containers without external dependencies
   */
  view c2_containers_focused {
    title 'Containers (Core)'
    
    include user
    include mySystem.*
    
    rank source { user }
    rank sink { mySystem.database }
  }

  /**
   * C2: Web App Detail
   * Demonstrates navigateTo from c2_containers
   */
  view c2_webapp_details {
    title 'Web App Detail'

    include user
    include mySystem.webapp
    include mySystem.api

    rank source { user }
    rank sink { mySystem.api }
  }
}
